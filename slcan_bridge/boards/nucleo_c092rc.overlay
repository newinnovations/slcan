/* Bump ST-LINK VCP (USART2) to 1 Mbps to prevent serial bottlenecks.
 *
 * USART2 has no RX FIFO: at 1 Mbaud each byte must be read within 10 us,
 * which interrupt-driven RX misses (bytes 3-5 of a back-to-back burst were
 * lost). RX runs into a circular DMA buffer instead (DMAMUX request 52 =
 * USART2_RX, channel 0), TX by DMA (request 53 = USART2_TX, channel 1).
 */
&usart2 {
	current-speed = <1000000>;
	dmas = <&dmamux1 1 53 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 52 (STM32_DMA_PERIPH_RX | STM32_DMA_MODE_CYCLIC |
			      STM32_DMA_PRIORITY_VERY_HIGH)>;
	dma-names = "tx", "rx";
};

&dma1 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};

/* CAN activity LEDs: LD1 (green, PA5) flashes on each sent frame, LD2 (blue,
 * PC9) on each received frame. PA5 doubles as SPI1_SCK and TIM1_CH1 in the
 * board DTS; neither driver is enabled, so the pin stays a GPIO.
 */
/ {
	aliases {
		can-tx-led = &green_led_1;
		can-rx-led = &blue_led;
	};
};
